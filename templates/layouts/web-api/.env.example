# Product-root env for local multi-app (api + web).
# Copy to product repo as .env.example → .env
# Per-app secrets can stay in api/.env and web/.env

APP_ENV=development

# Laptop port maps
API_HOST_PORT=8080
WEB_HOST_PORT=3000

# Baked into the web image at build time (must be reachable from the browser)
VITE_API_BASE_URL=http://localhost:8080

# API CORS. Local: *. Split publish: https://your-frontend.pages.dev,https://app.example.com
CORS_ORIGINS=*
